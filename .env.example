# Copy to .env (never commit it) or export these in the environment that launches the MCP server.
WC_BASE_URL=https://your-store.example.com
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxx      # WooCommerce > Settings > Advanced > REST API (Read only!)
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional
WC_REDACT_PII=true            # mask emails/phones/street addresses before they reach the model
WC_RATE_LIMIT_RPS=5           # client-side throttle (requests per second)
WC_MAX_RETRIES=5              # retries for 429/502/503/504/network errors
WC_TIMEOUT_SECONDS=20
WC_AUTH_MODE=basic            # use "query" only if your host strips the Authorization header
WC_LOG_LEVEL=WARNING
